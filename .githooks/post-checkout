#!/bin/sh
# Régénère les sommaires de mémoire/, qui ne sont plus versionnés
# (VAULT-CONTRACT.md §11). Silencieux, et jamais bloquant : un sommaire absent
# ou périmé gêne la lecture, il ne casse rien.
racine=$(git rev-parse --show-toplevel) || exit 0
[ -f "$racine/scripts/regenerate_sommaire.py" ] || exit 0
command -v python3 >/dev/null 2>&1 || exit 0
( cd "$racine" && python3 scripts/regenerate_sommaire.py >/dev/null 2>&1 ) || true
exit 0
