# Artefacts de compilation (à n'importe quelle profondeur)
target/
node_modules/
dist/
*.log
*.tmp

# Secrets — le dépôt est public. NE JAMAIS COMMITTER DE CLÉ NI DE JETON.
.env
.env.*
!.env.example
*.key
*.pem
id_rsa*
acme.json
config.php

# Profil d'installation (VAULT-CONTRACT §13) : il dit quels modules sont
# retenus SUR CETTE MACHINE, et recopie ce que la sonde y a trouvé. Versionné,
# il imposerait la configuration de son auteur à tout clone — et l'absence de
# profil vaut « catalogue complet », qui est justement l'état que la CI vérifie.
obsia.local.yml

# Prompt système généré : dérivé des frontmatters, et daté du jour où on l'a
# produit. Le régénérer coûte une seconde ; le versionner le fait diverger.
prompt-systeme.md

# Inventaires : gabarits versionnés, valeurs réelles hors dépôt
inventaire-*.yml
!inventaire-*.example.yml

# Configurations MCP remplies : seul le gabarit est versionné. Une config
# réelle porte le chemin du coffre et des références de jetons.
mcp.json
.mcp.json
!mcp.example.json

secrets/
.backup-reconstruction/

# Coffre synchronisé par Syncthing (hors du dépôt) : fichiers de conflit et
# dossiers internes qu'il dépose dans les répertoires partagés. Un fichier de
# conflit casse la règle d'unicité des noms de notes (VAULT-CONTRACT §6) et
# n'a rien à faire dans un commit. Ça ne dispense pas de faire ignorer
# `.git/` par Syncthing lui-même (.stignore, hors dépôt) : sans ça, le
# dépôt se corrompt — ce filtre-ci n'attrape que les fichiers de conflit.
*.sync-conflict-*
.stfolder/
.stversions/

# .archive/ n'est PAS ignoré : c'est l'archive des fichiers retirés du dépôt de
# l'outil, et un clone neuf doit la retrouver. Pour la mémoire, l'archivage,
# c'est l'historique Git du dépôt du coffre parent (§2) : plus de dossier.

# Caches Python — créés par les scripts du coffre
__pycache__/
*.pyc

# Sommaires de la mémoire (VAULT-CONTRACT §11) : générés localement, et
# réécrits par presque chaque séance. Versionnés, ils mettaient en conflit deux
# travaux sans rapport dès que plusieurs agents écrivaient en parallèle. La
# mémoire vit dans le coffre parent (§7.1) : ce filtre ne concerne que l'ancien
# `mémoire/` resté dans le dépôt pendant la bascule, dont les sommaires se
# régénèrent — crochets post-merge et post-checkout, installeur, revue
# hebdomadaire.
mémoire/**/sommaire.md
